# LLM 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-small

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./livestream_agent.db

# 向量数据库
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=livestream_knowledge

# 应用配置
APP_NAME=直播带货AI Agent
DEBUG=true
BATCH_SIZE=10
ANALYSIS_INTERVAL=5
MAX_TOKENS=500
